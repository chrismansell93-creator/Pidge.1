# Copy to .env for local development. Never commit real secrets.

DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PLAY_PRODUCT_ID="pidge_unlimited_monthly"

# Required in production (comma-separated). Without it, nobody can open /dashboard.
# In local/dev, unset falls back to the seeded owner test@example.com.
# ADMIN_EMAILS="you@example.com"
